{
  "name": "zubridge-monorepo",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/goosewobbler/zubridge",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build:packages",
    "build:electron-zustand-basic": "turbo run build:zustand-basic --filter=electron-e2e --force",
    "build:electron-zustand-handlers": "turbo run build:zustand-handlers --filter=electron-e2e --force",
    "build:electron-zustand-reducers": "turbo run build:zustand-reducers --filter=electron-e2e --force",
    "build:electron-redux": "turbo run build:redux --filter=electron-e2e --force",
    "build:electron-custom": "turbo run build:custom --filter=electron-e2e --force",
    "build:tauri": "turbo run build --filter=tauri-e2e --force",
    "build:tauri-v1": "turbo run build --filter=tauri-v1-e2e --force",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:publishable": "tsx scripts/check-publishable.ts",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "graph:e2e": "tsx ./scripts/create-task-graph.ts ./e2e-graph.png test:unit test:e2e:reducers test:e2e:handlers test:e2e:basic test:e2e:redux test:e2e:custom",
    "logs:e2e": "cat ./e2e/wdio-logs-electron-basic/wdio.log || cat ./e2e/wdio-logs-electron-handlers/wdio.log || cat ./e2e/wdio-logs-electron-reducers/wdio.log || cat ./e2e/wdio-logs-electron-redux/wdio.log || cat ./e2e/wdio-logs-electron-custom/wdio.log",
    "prepare": "husky",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:electron-zustand-basic": "cross-env DEBUG=zubridge:* turbo run test:e2e:electron-zustand-basic",
    "test:e2e:electron-zustand-handlers": "cross-env DEBUG=zubridge:* turbo run test:e2e:electron-zustand-handlers",
    "test:e2e:electron-zustand-reducers": "cross-env DEBUG=zubridge:* turbo run test:e2e:electron-zustand-reducers",
    "test:e2e:electron-redux": "cross-env DEBUG=zubridge:* turbo run test:e2e:electron-redux",
    "test:e2e:electron-custom": "cross-env DEBUG=zubridge:* turbo run test:e2e:electron-custom",
    "bench:electron": "pnpm --filter zubridge-e2e bench:electron",
    "bench:electron-zustand-basic": "pnpm --filter zubridge-e2e bench:electron-zustand-basic",
    "bench:electron-redux": "pnpm --filter zubridge-e2e bench:electron-redux",
    "bench:electron-custom": "pnpm --filter zubridge-e2e bench:electron-custom",
    "test:e2e:tauri-basic": "cross-env DEBUG=zubridge:* turbo run test:e2e:tauri",
    "test:e2e:tauri-v1-basic": "cross-env DEBUG=zubridge:* turbo run test:e2e:tauri-v1",
    "test:package": "pnpx tsx scripts/run-package-e2e.ts",
    "test:package:zustand-basic": "pnpx tsx scripts/run-package-e2e.ts zustand-basic",
    "test:package:custom": "pnpx tsx scripts/run-package-e2e.ts custom",
    "test:package:redux": "pnpx tsx scripts/run-package-e2e.ts redux",
    "test:package:zustand-handlers": "pnpx tsx scripts/run-package-e2e.ts zustand-handlers",
    "test:package:zustand-reducers": "pnpx tsx scripts/run-package-e2e.ts zustand-reducers",
    "update:releasekit": "tsx ./scripts/update-releasekit.ts",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate",
    "clean": "turbo run clean && pnpm clean:cache && pnpx shx rm -rf ./node_modules pnpm-lock.yaml",
    "clean:cache": "turbo run clean:cache && pnpx shx rm -rf .turbo",
    "clean:output": "turbo run clean:output"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goosewobbler/zubridge.git"
  },
  "keywords": [
    "zustand",
    "tauri",
    "electron",
    "cross-platform",
    "desktop-apps",
    "state-management"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@releasekit/release": "^0.47.1",
    "@types/shelljs": "^0.10.0",
    "@wdio/logger": "^10.2.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "shelljs": "^0.10.0",
    "shx": "^0.4.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "**/*.{yml,yaml,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
