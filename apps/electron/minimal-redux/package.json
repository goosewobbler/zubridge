{
  "name": "electron-minimal-redux",
  "version": "0.0.0",
  "description": "Minimal Electron app demonstrating Zubridge with Redux",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "clean": "pnpm clean:cache && pnpx shx rm -rf ./node_modules pnpm-lock.yaml",
    "clean:cache": "pnpx shx rm -rf .cache",
    "clean:output": "pnpx shx rm -rf ./dist* ./out* && pnpm run clean:cache",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "test": "cross-env DEBUG=wdio-electron-service*,webdriverio wdio run ./test/wdio.conf.ts",
    "test:package": "cross-env DEBUG=wdio-electron-service*,webdriverio wdio run ./test/wdio.conf.ts",
    "clean:logs": "pnpx shx rm -rf ./wdio-logs-*"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "@zubridge/electron": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redux": "^5.0.1",
    "scheduler": "^0.28.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@zubridge/types": "workspace:*",
    "autoprefixer": "^10.7.0",
    "cross-env": "^10.1.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "is-ci": "^4.1.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "@wdio/electron-service": "next",
    "webdriverio": "10.2.0",
    "mocha": "^12.0.3",
    "puppeteer-core": "^25.16.0"
  }
}
